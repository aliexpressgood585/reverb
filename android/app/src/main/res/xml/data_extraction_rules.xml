<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ form of backup_rules.xml. Same intent: keep the tower. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="app_webview/" />
        <exclude domain="file" path="app_webview/Cache/" />
        <exclude domain="file" path="app_webview/GPUCache/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="app_webview/" />
        <exclude domain="file" path="app_webview/Cache/" />
    </device-transfer>
</data-extraction-rules>
